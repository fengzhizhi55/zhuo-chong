// pet/pinkmaid-config.json —— 文件宠物（pet pack）：粉毛小女仆
//
// 素材目录：$DSH_HOME/dsh-pet/pet/pinkmaid-animation/（**平铺** .webm，不建 webm/ 子目录）
// 想加动作：把转好的 xxx.webm 放进素材目录，再把名字写进下面的动画池，重启桌面 Helper 即可。
//
// 素材（由即梦/豆包绿幕视频经 dsh-pet-assets 管线转出，**每段各自归一**到身高 266px/脚底 y=330，
// 所以源片里人物画得大一点小一点都没关系，切换动作时不会跳）：
//   待机.webm       idle       站立待机（全身带脚）
//   拎起来.webm     drag       被拎起来悬空挣扎（拖拽时播放）
//   转身.webm       turn       原地转身一周
//   转身2.webm      turn       另一版转身
//   左右看.webm     turn/edge  左右张望（同时是边缘探头用的动作）
//   打招呼.webm     clicks     跳起来打招呼、眯眼笑冒爱心（点击时播放）
//   眨眼卖萌.webm   categories 单眼眨眼卖萌（随机小动作）
//   左跑.webm       moves      跑步（素材标准朝向 = 朝左）
//   右跑.webm       moves      跑步（**转换时已水平镜像**成朝左，否则插件按朝向镜像时会反着跑）
//
// ⚠️ 朝向约定：插件默认朝向是 left（不镜像），朝右时自动 scaleX(-1)——
//    所以**所有动作素材都应该是「朝左」的**，朝右的素材必须先镜像再放进来。
//
// ⚠️ 权重与分类的关系：animationWeights 的 idle+turn+move 和所有 categories 的 weight
//    **加起来要是 100**。move 是 0 时走路那一支永远轮不到（加进 moves.actions 也不会走）。
//
// 联动还关着：balance / whisper / workStatus 各自要动画素材，没有素材开了会 404。
{
  "pets": [
    {
      "id": "pinkmaid",
      "name": "粉毛小女仆",
      "size": 420,
      "balanceEnabled": false,
      // A3：打开碎碎念 = 她偶尔会主动搭一句话。
      // 关键：插件的碎碎念**只写气泡、不挑动画**（host publishWhisper 只写 say），
      // 所以她不需要任何"说话"素材；但每句都是一次真实模型调用（周期见 eventsRefreshSec.whisper）。
      "whisperEnabled": true,
      "workStatusEnabled": false,
      "fixedEnabled": false,
      "display": "desktop",
      "position": {
        "corner": "bottom-right",
        "marginX": 24,
        "marginY": 100
      }
    }
  ],
  "animations": {
    "idle": [
      "待机"
    ],
    "turn": [
      "转身",
      "转身2",
      "左右看"
    ],
    "drag": [
      "拎起来"
    ],
    "clicks": [
      "打招呼"
    ],
    "moves": {
      "default": {
        "minDist": 260,
        "maxDist": 620,
        "margin": 20,
        "leadSec": 1.5,
        "tailSec": 2
      },
      "actions": [
        {
          "name": "左跑"
        },
        {
          "name": "右跑",
          "params": {
            "minDist": 300,
            "maxDist": 700
          }
        }
      ]
    },
    "categories": [
      {
        "id": "小动作",
        "weight": 40,
        "actions": [
          "打招呼",
          "左右看",
          "转身2",
          "眨眼卖萌"
        ]
      }
    ],
    "edge": {
      "enabled": true,
      "chance": 0.15,
      "cooldownSec": 120,
      "side": "random",
      "pool": [
        "左右看"
      ],
      "peekRatio": 0.42,
      "keepY": true,
      "hideMs": 420,
      "peekMs": 520,
      "returnMs": 900,
      "holdMs": 20000,
      "dropTrigger": true,
      "triggerDistRatio": 0.35,
      "parkAtEdge": true,
      "parkedPool": [
        "待机",
        "眨眼卖萌"
      ],
      "tiltDeg": 45,
      "tiltDir": "in",
      "tiltPivot": "feet",
      "tiltScope": "peek"
    },
    // B1「看鼠标」：光标靠近就朝它那侧转身、偶尔张望；贴到身上就打招呼。
    // lookRadius/greetRadius 是"身宽倍数"（420px 的身宽 → 默认 2.4 / 0.8 倍）。
    // 不想要就 enabled:false，或整段删掉（默认是开的，阈值用内置默认）。
    "cursor": {
      "enabled": true,
      "lookRadius": 2.4,
      "greetRadius": 0.8,
      "lookCooldownSec": 25,
      "greetCooldownSec": 60
    },
    // 宠物间互动：和蓝毛凑近时会互相看一眼，并聊上一句。
    // 台词是**本地随机抽**的（走宿主 /broadcast 写气泡），完全不经过模型 → 零 token。
    //   radiusRatio   多近算凑在一起（身宽倍数）：2.4 ≈ 1000px，"放在附近"就够
    //   greetChance   凑近那一下说话的把握（1 = 必定理你；想"有时不理人"就调小）
    //   greetCooldownSec 两次开口之间的最小间隔（防反复拖来拖去刷屏）
    //   idleMin/MaxSec + idleChance：挨着坐之后，隔 90~180 秒掷一次"要不要再聊一句"
    "social": {
      "enabled": true,
      "radiusRatio": 2.4,
      "greetChance": 1,
      "greetCooldownSec": 60,
      "idleMinSec": 90,
      "idleMaxSec": 180,
      "idleChance": 0.5,
      "lines": [
        "前辈在呀！",
        "我可不是新来的～",
        "要不要一起玩？",
        "主人把我做得比你可爱哦",
        "别抢我位置呀",
        "哼，你也没在干活嘛",
        "陪我玩一会儿嘛",
        "今天也要乖乖的哦"
      ]
    },
    "events": {
      "balance": [
        "balance-unused-placeholder"
      ]
    }
  },
  "animationWeights": {
    "idle": 40,
    "turn": 10,
    "move": 10
  },
  // A1「她的人设」：同时决定 **桌面感知 / 碎碎念 / 对话** 三处的说话风格。
  // 不写的话她会继承主宠物那份（"Q版蓝发小女仆" ✗），所以必须自己写一份。
  "whisperPrompt": "你是主人亲手做出来的Q版粉发小女仆（粉色长发、红色蝴蝶结、白裙），会时不时碎碎念一句。说话要自然随意、短短一句（20字以内），活泼黏人、爱撒娇，偶尔为“我是主人自己做的”这点小得意。说人话不啰嗦，不要解释你自己，不要提你是AI。",
  "eventsRefreshSec": {
    "balance": 1800,
    "whisper": 900
  }
}
